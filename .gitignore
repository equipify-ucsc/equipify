# PHP / Composer
/vendor/
composer.phar
composer.lock
*.log

# Environment / secrets — critical for MySQL credentials
.env
.env.local
config.php

# Encryption key for stored payout details (core/Crypto.php generates it on
# first use). Committing it would make the encrypted columns readable by anyone
# with the repo, which is the whole point of encrypting them.
backend/config/app_key.php

# IDE / editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Uploads / user-generated content (if applicable)
/uploads/
/tmp/

# Files uploaded through the app (credential documents, portfolio and
# equipment photos). Keep .gitkeep so the folder exists in a fresh clone.
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep

# Profile pictures for every role (users.profile_photo_url).
backend/storage/profile-photos/*
!backend/storage/profile-photos/.gitkeep

# Logs and cache
*.cache
error_log

# Claude Code / local reference docs
CLAUDE.md
/Information/
.claude/

dev-router.php