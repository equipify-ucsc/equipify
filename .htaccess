Options -Indexes

# Never expose repository metadata, SQL, documentation or private PHP layers.
RewriteEngine On
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:schema|docs|tmp|sessions|Information)(?:/|$) - [F,L,NC]
RewriteRule ^backend/(?!api(?:/|$)) - [F,L,NC]
<FilesMatch "(?i)(\.(sql|log|ini|env|bak|dist|md|eml)$|^sess_|^composer\.(json|lock)$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>
