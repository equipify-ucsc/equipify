# Documentation only: PHP does NOT automatically load this file.
# Set process environment variables in the terminal that starts PHP/Apache.
EQUIPIFY_MAIL_TRANSPORT=file
EQUIPIFY_MAIL_ENABLE_SEND=0
EQUIPIFY_MAIL_FROM=sender@example.test
EQUIPIFY_MAIL_FROM_NAME=Equipify
EQUIPIFY_MAIL_FALLBACK=file
EQUIPIFY_MAIL_TIMEOUT=15
# Use a private directory outside the web root for file output.
EQUIPIFY_MAIL_DIRECTORY=
# Native profile setup reads these; provide real values locally, never in Git.
EQUIPIFY_SMTP_HOST=
EQUIPIFY_SMTP_PORT=587
EQUIPIFY_SMTP_SECURITY=tls
EQUIPIFY_SMTP_USERNAME=
EQUIPIFY_SMTP_PASSWORD=
# Set by configure_sendmail.ps1 to its new ACL-protected executable.
EQUIPIFY_SENDMAIL_EXE=
# An explicitly approved recipient for CLI verification only.
EQUIPIFY_MAIL_TEST_RECIPIENT=
